# No API key is required by the public Elexon Insights API.
DECISION_CUTOFF=10:00
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CACHE_PATH=backend/data/cache.json
CACHE_TTL_SECONDS=86400
ELEXON_TIMEOUT_SECONDS=40
# Set a strong random value on public deployments; refresh is disabled without it.
REFRESH_TOKEN=
# Optional. Leave empty for same-origin /api requests and the Vite dev proxy.
VITE_API_BASE_URL=
