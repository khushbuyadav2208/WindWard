{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci --no-audit --no-fund && npm --prefix frontend run build",
  "functions": {
    "index.py": {
      "maxDuration": 180,
      "includeFiles": "{backend/**,frontend/dist/**}"
    }
  },
  "env": {
    "CACHE_PATH": "/tmp/windward-cache.json"
  }
}
